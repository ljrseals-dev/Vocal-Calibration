//------------------------------------------------------------------------------
// MouthModel v1.0 — Kelly-Lochbaum Vocal Tract Physical Model
//
// PHYSICAL MODEL OVERVIEW
// ─────────────────────────────────────────────────────────────────────────────
// The human vocal tract is modelled as a chain of N cylindrical tube segments
// of equal length but varying cross-sectional area.  At each junction between
// segments the acoustic wave partially reflects and partially transmits
// according to the Kelly-Lochbaum reflection coefficient:
//
//   k_j = (A_{j+1} - A_j) / (A_{j+1} + A_j)
//
// where A_j is the cross-sectional area of segment j.  Each segment is a
// bidirectional delay line (one forward-travelling wave, one backward).
// The chain naturally models formant resonances (F1–F4) as standing-wave
// patterns across the tract length.
//
// SOURCES
// ─────────────────────────────────────────────────────────────────────────────
// VOICED (glottal pulse):
//   Liljencrants-Fant (LF) model.  Two-phase glottal pulse:
//     Open phase:   g(t) = E0 * t² * exp(-αt)        rising + peak
//     Return phase: g(t) = -Ee * (exp(-ε(t-te)) - 1)  abrupt closure
//   This gives the asymmetric, slightly buzzy waveform of real vocal folds.
//   Rd parameter controls "voice quality" from breathy (Rd=2.7) to pressed
//   (Rd=0.3).  Here simplified to a two-parameter (Ee, alpha) approximation
//   that captures the essential shape without iterative root-finding.
//
// UNVOICED (turbulent noise):
//   Flat-spectrum noise injected at a constriction point in the tract (tract
//   segment 5, approximately the alveolar ridge position for /s/, /f/).
//   Noise amplitude scales with breathiness parameter.
//   A simple one-pole noise pre-filter gives the turbulence its coloured
//   character (pink-ish rather than white).
//
// TRACT GEOMETRY (8 segments)
// ─────────────────────────────────────────────────────────────────────────────
//   Segment 0:  glottis / pharynx base    (area controlled by jaw + throat)
//   Segment 1:  lower pharynx
//   Segment 2:  upper pharynx
//   Segment 3:  velum / back of tongue
//   Segment 4:  tongue body              (area controlled by tongue param)
//   Segment 5:  alveolar region          (constriction for fricatives)
//   Segment 6:  teeth / front cavity
//   Segment 7:  lips                     (area controlled by lips param)
//   Radiation:  lip end → free-space radiation (first-order high-shelf)
//
// VOWEL FORMANT TARGETS
// ─────────────────────────────────────────────────────────────────────────────
// The eight area parameters are morphed toward vowel targets via morph control.
// Approx. area profiles (relative units, 1.0 = neutral):
//   /a/ (ah): jaw open, tongue low-back  → high areas 0-2, low 4-5
//   /e/ (eh): mid-front tongue           → low 3-4, higher 5-7
//   /i/ (ee): tongue high-front          → low 4, high 6-7
//   /o/ (oh): lip rounding, back tongue  → low 7, high 3-4
//   /u/ (oo): tongue high-back + lips    → low 4 + low 7
//
// CONTROLS
// ─────────────────────────────────────────────────────────────────────────────
//   pitch        — fundamental F0, Hz (voiced mode)
//   vowel        — 0=ah  0.25=eh  0.5=ee  0.75=oh  1.0=oo  (interpolated)
//   jaw          — jaw opening: scales pharynx area (segments 0-1)
//   tongue       — tongue body height: scales segment 4 area
//   lips         — lip aperture: scales segment 7 area
//   breathiness  — mix of glottal noise into the pulse (breathy voice quality)
//   nasality     — simple first-order shelf adding nasal murmur
//   voiced       — 1=voiced (glottal pulse), 0=unvoiced (fricative noise)
//   fricative    — turbulence noise level at constriction (seg 5)
//   drive        — nonlinear fold-back at glottis (vocal fry at high values)
//
//------------------------------------------------------------------------------

processor MouthModel [[ main ]]
{
    input  stream float32 audioIn;        // not used, reserved
    output stream float32 audioOut;

    // ── Controls ──────────────────────────────────────────────────────────────
    param  float64 sampleRate   [[ name: "Sample Rate",           init: 48000.0 ]];
    input  value float32 pitch       [[ name: "Pitch (Hz)",            min: 50,   max: 600,  init: 120  ]];
    input  value float32 vowel       [[ name: "Vowel (ah→oo)",         min: 0,    max: 1.0,  init: 0.0  ]];
    input  value float32 jaw         [[ name: "Jaw Open",              min: 0.1,  max: 2.0,  init: 1.0  ]];
    input  value float32 tongue      [[ name: "Tongue Height",         min: 0.1,  max: 2.0,  init: 1.0  ]];
    input  value float32 lips        [[ name: "Lip Aperture",          min: 0.05, max: 2.0,  init: 1.0  ]];
    input  value float32 breathiness [[ name: "Breathiness",           min: 0,    max: 1.0,  init: 0.1  ]];
    input  value float32 nasality    [[ name: "Nasality",              min: 0,    max: 1.0,  init: 0.0  ]];
    input  value float32 voiced      [[ name: "Voiced (1) / Noise(0)", min: 0,    max: 1.0,  init: 1.0  ]];
    input  value float32 fricative   [[ name: "Fricative Level",       min: 0,    max: 1.0,  init: 0.0  ]];
    input  value float32 drive       [[ name: "Glottal Drive (Fry)",   min: 0.5,  max: 3.0,  init: 1.0  ]];

    // ── Constants ─────────────────────────────────────────────────────────────
    let N_SEGS = 8;    // tract segment count

    // Vowel area profiles [N_SEGS] — relative cross-sectional areas
    // Rows: ah, eh, ee, oh, oo
    // Areas are in arbitrary units; ratios are what matter for reflection coeffs.
    let vowelAh = float32[8] (1.8, 1.6, 1.4, 0.9, 0.7, 0.8, 1.2, 1.0);
    let vowelEh = float32[8] (1.2, 1.1, 1.0, 0.6, 0.5, 0.9, 1.3, 1.1);
    let vowelEe = float32[8] (1.0, 0.9, 0.8, 0.5, 0.3, 1.1, 1.5, 1.2);
    let vowelOh = float32[8] (1.4, 1.3, 1.2, 1.1, 0.9, 0.7, 0.8, 0.4);
    let vowelOo = float32[8] (1.2, 1.0, 0.9, 1.0, 0.4, 0.6, 0.7, 0.2);

    // ── State ─────────────────────────────────────────────────────────────────

    // Waveguide: forward (+) and backward (-) travelling waves per segment
    float32[8] wgPlus  = (0, 0, 0, 0, 0, 0, 0, 0);
    float32[8] wgMinus = (0, 0, 0, 0, 0, 0, 0, 0);

    // Glottal source state
    float64 glotPhase    = 0.0;
    float32 glotLast     = 0.0f;     // for LF return-phase tracking
    float32 glotReturn   = 0.0f;

    // Noise / LFSR
    uint32  lfsrA = 0xACE1u;
    uint32  lfsrB = 0x7F3Du;
    float32 noiseLP = 0.0f;          // one-pole noise pre-filter state

    // Radiation filter state (lip end, first-order HP)
    float32 radLast  = 0.0f;

    // Nasal shelf state
    float32 nasalLP  = 0.0f;

    // Tract smoothing (area changes are low-pass filtered to avoid clicks)
    float32[8] smoothArea = (1, 1, 1, 1, 1, 1, 1, 1);

    // ── Helpers ───────────────────────────────────────────────────────────────

    // Dual LFSR white noise — two independent 16-bit sequences XOR'd for
    // better spectral flatness than a single register.
    float32 whiteNoise()
    {
        uint32 bA = ((lfsrA >> 0) ^ (lfsrA >> 2) ^ (lfsrA >> 3) ^ (lfsrA >> 5)) & 1u;
        lfsrA     = (lfsrA >> 1) | (bA << 15);
        uint32 bB = ((lfsrB >> 0) ^ (lfsrB >> 1) ^ (lfsrB >> 3) ^ (lfsrB >> 4)) & 1u;
        lfsrB     = (lfsrB >> 1) | (bB << 15);
        return (float32 (lfsrA ^ lfsrB) / 32767.5f) - 1.0f;
    }

    // Lerp helper
    float32 lerp (float32 a, float32 b, float32 t) { return a + t * (b - a); }

    // Vowel area profile interpolation across the five vowel targets.
    // vowelParam is [0,1], mapped to 5 evenly spaced targets.
    float32 getVowelArea (int seg, float32 vowelParam)
    {
        float32 v  = vowelParam * 4.0f;      // 0..4
        int     lo = int (v);
        float32 t  = v - float32 (lo);
        if (lo >= 4) { lo = 4; t = 0.0f; }

        float32 aLo, aHi;

        // Fetch low target
        if      (lo == 0) { aLo = vowelAh[seg]; aHi = vowelEh[seg]; }
        else if (lo == 1) { aLo = vowelEh[seg]; aHi = vowelEe[seg]; }
        else if (lo == 2) { aLo = vowelEe[seg]; aHi = vowelOh[seg]; }
        else              { aLo = vowelOh[seg]; aHi = vowelOo[seg]; }

        return lerp (aLo, aHi, t);
    }

    // ── LF Glottal pulse (simplified two-phase) ───────────────────────────────
    //
    // Open phase (0 → tp):  g = (phase/tp)² × (1 − phase/tp)  — parabolic rise
    //   scaled so peak = 1 at phase = tp * 2/3
    // Return phase (tp → 1): exponential closure, rate set by drive
    //   g = −Ee × exp(−ε × (phase − tp) / (1 − tp))
    //   where Ee = peak open-phase value, ε = drive (controls closure speed)
    //
    // Breathiness adds broadband noise to the open phase only (aspiration).
    //
    float32 glottalPulse (float32 breathAmt, float32 driveAmt)
    {
        float32 tp  = 0.65f;    // open quotient (fraction of period in open phase)
        float32 ph  = float32 (glotPhase);
        float32 g;

        if (ph < tp)
        {
            float32 x = ph / tp;
            // Parabolic open phase — peak near x=0.67
            g = x * x * (3.0f - 2.0f * x) * 2.0f - 1.0f;
            // Add aspiration noise during open phase
            g += whiteNoise() * breathAmt * 0.4f;
        }
        else
        {
            // Exponential return (closure) — steeper with higher drive (fry)
            float32 t  = (ph - tp) / (1.0f - tp);
            float32 eps = driveAmt * 6.0f;
            g = -std::math::exp (-eps * t);
            // Vocal fry: nonlinear fold at high drive
            if (driveAmt > 1.5f)
                g = std::math::tanh (g * driveAmt);
        }

        return g;
    }

    // ── Kelly-Lochbaum waveguide scatter step ─────────────────────────────────
    //
    // One scatter pass across all N_SEGS-1 junctions.
    // At junction j between segments j and j+1:
    //
    //   k_j    = (A[j+1] - A[j]) / (A[j+1] + A[j])
    //   pRefl  = k_j  × wgPlus[j]  +  (1+k_j)  × wgMinus[j+1]  (goes left)
    //   pTrans = (1-k_j) × wgPlus[j]  +  k_j    × wgMinus[j+1]  (goes right)
    //
    // Glottal input enters at segment 0 as a forward wave.
    // Radiation load at segment N-1 lip end: wgMinus[N-1] = −0.95 × wgPlus[N-1]
    // (first-order lip radiation reflection, slightly lossy).
    //
    void scatterTract (float32 glotInput, float32[8]& area)
    {
        // Inject source at glottis (segment 0 forward wave)
        wgPlus[0] = glotInput;

        // Scatter at each junction
        float32[8] newPlus  = wgPlus;
        float32[8] newMinus = wgMinus;

        for (int j = 0; j < N_SEGS - 1; j++)
        {
            float32 aJ  = area[j];
            float32 aJ1 = area[j + 1];
            float32 denom = aJ + aJ1;
            float32 kJ  = (denom > 0.0001f) ? (aJ1 - aJ) / denom : 0.0f;

            float32 pFwd = wgPlus[j];
            float32 pBwd = wgMinus[j + 1];

            newMinus[j]     = kJ * pFwd + (1.0f + kJ) * pBwd;   // reflected left
            newPlus[j + 1]  = (1.0f - kJ) * pFwd + kJ * pBwd;   // transmitted right
        }

        // Lip radiation boundary: partial reflection with loss (~0.95)
        // and first-order high-pass (radiation impedance is proportional
        // to frequency, so output = x - 0.95*xPrev models free-space radiation)
        newMinus[N_SEGS - 1] = -0.95f * newPlus[N_SEGS - 1];

        wgPlus  = newPlus;
        wgMinus = newMinus;
    }

    // ── Main DSP loop ─────────────────────────────────────────────────────────
    void main()
    {
        loop
        {
            float32 sr = float32 (sampleRate);

            // ── Glottal advance ───────────────────────────────────────────────
            float64 dt = float64 (pitch) / sampleRate;
            glotPhase  = std::math::fmod (glotPhase + dt, 1.0);

            // ── Glottal source ────────────────────────────────────────────────
            float32 glotSig = 0.0f;

            if (voiced > 0.5f)
                glotSig = glottalPulse (breathiness, drive);

            // Unvoiced: broadband noise (coloured by one-pole LP)
            float32 rawNoise = whiteNoise();
            noiseLP          = noiseLP * 0.7f + rawNoise * 0.3f;
            float32 coloured = rawNoise * 0.6f + noiseLP * 0.4f;   // pinkish

            // Fricative injection at constriction (segment 5) — added to
            // waveguide forward wave at that segment after scatter
            float32 fricSig = coloured * fricative;

            // Mix voiced + unvoiced at glottis
            glotSig = glotSig * voiced
                    + coloured * (1.0f - voiced) * 0.5f
                    + glotSig * breathiness * coloured * 0.3f;

            // ── Build area function ───────────────────────────────────────────
            // Interpolate vowel target, then scale segments by jaw/tongue/lips.
            float32[8] targetArea;
            for (int s = 0; s < N_SEGS; s++)
                targetArea[s] = getVowelArea (s, vowel);

            // Articulatory modifiers
            targetArea[0] *= jaw;    // pharynx base — jaw opens this
            targetArea[1] *= jaw;
            targetArea[4] *= tongue; // tongue body constriction
            targetArea[7] *= lips;   // lip aperture

            // Smooth area changes to suppress discontinuity clicks
            // (one-pole with ~5ms time constant)
            float32 smoothCoef = std::math::exp (-1.0f / (sr * 0.005f));
            for (int s = 0; s < N_SEGS; s++)
                smoothArea[s] = smoothArea[s] * smoothCoef
                              + targetArea[s] * (1.0f - smoothCoef);

            // ── Scatter waveguide ─────────────────────────────────────────────
            scatterTract (glotSig, smoothArea);

            // Inject fricative at constriction point (segment 5)
            wgPlus[5] += fricSig * 0.4f;

            // ── Radiation output  ─────────────────────────────────────────────
            // Output is taken at the lip end (forward wave leaving segment 7).
            // First-order differentiation models radiation pressure:
            //   out = wgPlus[N-1] - 0.95 * radLast
            float32 lipOut = wgPlus[N_SEGS - 1] - 0.95f * radLast;
            radLast = wgPlus[N_SEGS - 1];

            // ── Nasality  ─────────────────────────────────────────────────────
            // Simple first-order shelf: nasal murmur is a low-passed copy
            // of the tract output blended in.  Real nasality involves a
            // side-branch resonator; this approximation adds the characteristic
            // low-frequency nasal formant darkening.
            nasalLP = nasalLP * 0.85f + lipOut * 0.15f;
            float32 out = lipOut + nasalLP * nasality * 0.5f;

            // ── Output gain / final soft-clip ─────────────────────────────────
            audioOut <- std::math::tanh (out * 2.5f) * 0.7f;

            advance();
        }
    }
}
